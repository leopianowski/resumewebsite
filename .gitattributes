# Normaliza fim de linha: LF no repositório, nativo no disco de cada um.
# Sem isso, o mesmo arquivo editado no Windows e no CI (Linux) gera diff
# fantasma de linha inteira.
* text=auto eol=lf

# Binários — nunca normalizar nem tentar diff de texto.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff binary
*.woff2 binary
